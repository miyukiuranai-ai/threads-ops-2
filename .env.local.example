# ============================================================
# Threads自動運用ツール / Phase 1 用の環境変数テンプレート
# ------------------------------------------------------------
# 使い方:
#   cp .env.local.example .env.local
#   .env.local に実際の値を記入する（.env.local はGit管理外）
# 値は絶対にコードへ直書きしないこと。
# ============================================================

# --- Meta for Developers > アプリ > Threads > 設定 で取得 ---
# 注意: Meta の「アプリID」ではなく "Threads アプリID / シークレット" を使う
THREADS_APP_ID=
THREADS_APP_SECRET=

# OAuth のリダイレクト先。Meta 側に登録したものと完全一致させる（HTTPS必須・末尾スラッシュも一致）
THREADS_REDIRECT_URI=https://localhost:3000/auth/threads/callback

# --- 認可フローで取得した値（scripts/exchange-token.mjs が出力）---
# 長期トークン（有効期限60日）
THREADS_ACCESS_TOKEN=
# 上記トークンの持ち主の Threads ユーザーID（数値）
THREADS_USER_ID=
# 長期トークンの失効日時（ISO8601）。運用時の期限監視用のメモ
THREADS_TOKEN_EXPIRES_AT=

# --- テスト投稿の本文（未設定ならスクリプト側のデフォルト文言）---
TEST_POST_TEXT=

# ============================================================
# Firestore（SETUP-FIREBASE.md 参照）
# npm run db:setup -- "<サービスアカウントJSONのパス>" で自動記入できる
# ============================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# JSONの private_key をそのまま（
 を文字のまま残して）ダブルクォートで囲む
FIREBASE_PRIVATE_KEY=

# ============================================================
# 投稿文の生成（Phase 2）
# https://console.anthropic.com で発行
# ============================================================
ANTHROPIC_API_KEY=

# ============================================================
# 投稿ガード
#   dry_run … 生成・承認・予約まで動くが実際には投稿しない（既定・安全）
#   live    … 実際に Threads へ投稿する
# ============================================================
POSTING_MODE=dry_run

# Cron エンドポイントの認可キー（任意のランダム文字列。Vercelにも同じ値を登録）
CRON_SECRET=
