# Firebase（本家とは別プロジェクト・別バケットを新規に作る）
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=

# Anthropic（生成用）
ANTHROPIC_API_KEY=

# ログイン
ADMIN_USER=admin
ADMIN_PASSWORD=
# 管理者以外。user:password:group をカンマ区切り
MEMBERS=suzuki:pw:teamB
SESSION_SECRET=

# 定期実行の認可
CRON_SECRET=

# 投稿・返信のモード（dry_run / live）
POSTING_MODE=dry_run
REPLY_MODE=dry_run
PUBLISH_GRACE_MINUTES=20
AUTO_REVIEW_AT=23:30
INSIGHTS_COLLECT_AT=03:20

# 被り判定のしきい値
FARMER_ACCOUNTS=2
FARMER_ACCOUNTS_BY_GROUP=teamB:4

# コマンドの操作者
OPS_USER=suzuki
OPS_ROLE=member

# Threads（Meta for Developers）
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://localhost/callback
